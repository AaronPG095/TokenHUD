<Window x:Class="TokenHud.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="Token HUD"
        Width="392" Height="340"
        MinWidth="360" MinHeight="324"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ToolTipService.InitialShowDelay="250"
        ToolTipService.BetweenShowDelay="100"
        ToolTipService.ShowDuration="12000"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        StateChanged="Window_StateChanged"
        KeyDown="Window_KeyDown">
    <Border BorderBrush="{DynamicResource SurfaceStrongBrush}" BorderThickness="1" Background="{DynamicResource CanvasBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleStrip" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleStrip_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="HealthDot" Grid.Column="0" Width="8" Height="8" Margin="14,0,10,0" Fill="{DynamicResource HealthyBrush}" VerticalAlignment="Center"
                         automation:AutomationProperties.Name="Local source healthy" />
                <TextBlock Grid.Column="1" Text="Token HUD" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,6,0" automation:AutomationProperties.Name="Window controls">
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Click="PinButton_Click" ToolTip="Pin current chat"
                            automation:AutomationProperties.Name="Pin current chat">
                        <Viewbox Width="15" Height="15">
                            <Path Data="M8,2 L16,2 L16,4 L15,5 L15,12 L18,15 L18,17 L13,17 L13,22 L11,22 L11,17 L6,17 L6,15 L9,12 L9,5 L8,4 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="PrivacyButton" Style="{StaticResource IconButton}" Click="PrivacyButton_Click" ToolTip="Hide chat names"
                            automation:AutomationProperties.Name="Hide chat names">
                        <Viewbox Width="17" Height="17">
                            <Grid Width="24" Height="24">
                                <Path Data="M2,12 C5,7 8,5 12,5 C16,5 19,7 22,12 C19,17 16,19 12,19 C8,19 5,17 2,12 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Fill="Transparent" />
                                <Ellipse Width="6" Height="6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" />
                                <Path Data="M4,3 L20,21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" />
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="ExpandButton" Style="{StaticResource IconButton}" Click="ExpandButton_Click" ToolTip="Show all chats and details"
                            automation:AutomationProperties.Name="Show all chats and details">
                        <Viewbox Width="16" Height="16">
                            <Path Data="M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="HideButton_Click" ToolTip="Hide to notification area"
                            automation:AutomationProperties.Name="Hide to notification area">
                        <Viewbox Width="16" Height="16">
                            <Path Data="M5,17 L19,17"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="16,4,16,14" Padding="14" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock x:Name="ModeLabel" Text="Following latest" Style="{StaticResource MutedText}" FontSize="10.5" />
                                <TextBlock x:Name="ChatPositionLabel" Text="1 of 1" Style="{StaticResource MutedText}" FontSize="10.5" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="TrackedTitle" Text="Connecting to Codex…" FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxHeight="40"
                                       automation:AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}">
                                <TextBlock.ToolTip>
                                    <ToolTip Placement="Bottom">
                                        <TextBlock Text="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                                   MaxWidth="360" TextWrapping="Wrap" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PreviousChatButton" Style="{StaticResource IconButton}" Click="PreviousChatButton_Click"
                                    ToolTip="Newer chat (Ctrl+Page Up)" automation:AutomationProperties.Name="Show newer chat">
                                <Viewbox Width="13" Height="13">
                                    <Path Data="M15,4 L7,12 L15,20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                </Viewbox>
                            </Button>
                            <Button x:Name="NextChatButton" Style="{StaticResource IconButton}" Click="NextChatButton_Click"
                                    ToolTip="Older chat (Ctrl+Page Down)" automation:AutomationProperties.Name="Show older chat">
                                <Viewbox Width="13" Height="13">
                                    <Path Data="M9,4 L17,12 L9,20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CONTEXT LOAD" Style="{StaticResource MutedText}" FontSize="10.5" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="ContextValue" Text="—" FontSize="28" FontWeight="SemiBold" />
                                <TextBlock x:Name="BudgetValue" Text=" / 100k" Margin="4,10,0,0" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="ZoneBadge" Grid.Column="1" Padding="8,4" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource SurfaceStrongBrush}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Top">
                            <TextBlock x:Name="ZoneLabel" Text="Healthy" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <ProgressBar x:Name="ContextMeter" Style="{StaticResource Meter}" Minimum="0" Maximum="100" Value="0"
                                     automation:AutomationProperties.Name="Context budget used" />
                        <Grid Margin="0,6,0,0">
                            <TextBlock x:Name="VelocityLabel" Text="Waiting for usage samples" Style="{StaticResource MutedText}" />
                            <Border x:Name="SpikeBadge" HorizontalAlignment="Right" Padding="6,2" CornerRadius="5" Background="{DynamicResource CanvasBrush}" Visibility="Collapsed">
                                <TextBlock x:Name="SpikeLabel" Text="Spike +0" FontSize="10.5" Foreground="{DynamicResource CriticalBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SESSION CONSUMPTION" Style="{StaticResource MutedText}" FontSize="10.5" FontWeight="SemiBold" />
                            <TextBlock x:Name="ConsumptionValue" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" MaxWidth="185">
                            <TextBlock Text="HIGHEST CHILD" Style="{StaticResource MutedText}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock x:Name="ChildWarning" Text="No active subagents" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="5-HOUR QUOTA" Style="{StaticResource MutedText}" FontSize="10" />
                                <TextBlock x:Name="PrimaryQuotaLabel" Text="—" HorizontalAlignment="Right" FontSize="10.5" />
                            </Grid>
                            <ProgressBar x:Name="PrimaryQuotaMeter" Grid.Row="1" Style="{StaticResource Meter}" Height="4" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <TextBlock Text="WEEKLY QUOTA" Style="{StaticResource MutedText}" FontSize="10" />
                                <TextBlock x:Name="SecondaryQuotaLabel" Text="—" HorizontalAlignment="Right" FontSize="10.5" />
                            </Grid>
                            <ProgressBar x:Name="SecondaryQuotaMeter" Style="{StaticResource Meter}" Height="4" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="ExpandedPanel" Grid.Row="2" Margin="16,0,16,14" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="CHATS" Style="{StaticResource MutedText}" FontSize="10.5" FontWeight="SemiBold" />
                            <TextBox x:Name="SearchBox" Margin="0,6,0,0" TextChanged="SearchBox_TextChanged" ToolTip="Search local chat titles, IDs, and project paths"
                                     automation:AutomationProperties.Name="Search local chats" />
                        </StackPanel>
                        <CheckBox x:Name="ArchivedCheckBox" Grid.Row="1" Content="Include archived" Margin="2,10,0,8" Checked="ArchivedCheckBox_Changed" Unchecked="ArchivedCheckBox_Changed" />
                        <ListBox x:Name="ChatList" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="ChatList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 automation:AutomationProperties.Name="Recent Codex chats">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource MutedText}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="3" Text="Select a chat to track it. Use the pin button to follow the latest again." Style="{StaticResource MutedText}" FontSize="10.5" Margin="2,8,0,0" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="TOKEN BREAKDOWN" Style="{StaticResource MutedText}" FontSize="10.5" FontWeight="SemiBold" />
                        <Grid Grid.Row="1" Margin="0,8,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Input" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="InputValue" Text="—" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Cached" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="CachedValue" Text="—" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Output" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="OutputValue" Text="—" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Reasoning" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="ReasoningValue" Text="—" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="ThreadGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                                  AlternatingRowBackground="{DynamicResource CanvasBrush}" HorizontalGridLinesBrush="{DynamicResource SurfaceStrongBrush}" Foreground="{DynamicResource InkBrush}"
                                  FontSize="11.5" RowHeight="30" SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="" Binding="{Binding Marker}" Width="22" />
                                <DataGridTextColumn Header="Thread" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Context" Binding="{Binding Context}" Width="72" />
                                <DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="68" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="72" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Budget" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="BudgetBox" Grid.Column="1" Width="76" LostFocus="BudgetBox_LostFocus" KeyDown="BudgetBox_KeyDown" ToolTip="Context budget in tokens" />
                            <CheckBox x:Name="TopmostCheckBox" Grid.Column="2" Content="On top" Margin="14,0,0,0" Checked="TopmostCheckBox_Changed" Unchecked="TopmostCheckBox_Changed" />
                            <CheckBox x:Name="NotifyCheckBox" Grid.Column="3" Content="Notify" Margin="14,0,0,0" Checked="NotifyCheckBox_Changed" Unchecked="NotifyCheckBox_Changed" />
                            <Button Grid.Column="4" Content="Pause" x:Name="PauseButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Click="PauseButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="StatusBar" Grid.Row="3" Margin="18,0,18,10" Visibility="Collapsed">
                <TextBlock x:Name="SourceHealthLabel" Text="Local source status" Style="{StaticResource MutedText}" FontSize="10.5" />
                <TextBlock x:Name="RefreshLabel" Text="—" Style="{StaticResource MutedText}" FontSize="10.5" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</Window>
