<Window x:Class="TokenHud.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="Token HUD"
        Width="392" Height="390"
        MinWidth="360" MinHeight="360"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ToolTipService.InitialShowDelay="250"
        ToolTipService.BetweenShowDelay="100"
        ToolTipService.ShowDuration="12000"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        StateChanged="Window_StateChanged"
        KeyDown="Window_KeyDown">
    <Border BorderBrush="{DynamicResource SurfaceStrongBrush}" BorderThickness="1" Background="{DynamicResource CanvasBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleStrip" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleStrip_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="HealthDot" Grid.Column="0" Width="8" Height="8" Margin="14,0,10,0"
                         Fill="{DynamicResource HealthyBrush}" VerticalAlignment="Center"
                         automation:AutomationProperties.Name="Local source healthy" />
                <TextBlock Grid.Column="1" Text="Token HUD" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,6,0"
                            automation:AutomationProperties.Name="Window controls">
                    <Button x:Name="PrivacyButton" Style="{StaticResource IconButton}" Click="PrivacyButton_Click"
                            ToolTip="Hide chat names" automation:AutomationProperties.Name="Hide chat names">
                        <Viewbox Width="17" Height="17">
                            <Grid Width="24" Height="24">
                                <Path Data="M2,12 C5,7 8,5 12,5 C16,5 19,7 22,12 C19,17 16,19 12,19 C8,19 5,17 2,12 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Fill="Transparent" />
                                <Ellipse Width="6" Height="6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" />
                                <Path Data="M4,3 L20,21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" />
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="ExpandButton" Style="{StaticResource IconButton}" Click="ExpandButton_Click"
                            ToolTip="Show all chats and details" automation:AutomationProperties.Name="Show all chats and details">
                        <Viewbox Width="16" Height="16">
                            <Path Data="M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="HideButton_Click" ToolTip="Hide to notification area"
                            automation:AutomationProperties.Name="Hide to notification area">
                        <Viewbox Width="16" Height="16">
                            <Path Data="M5,17 L19,17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <Border x:Name="CompactPanel" Grid.Row="1" Margin="12,2,12,12" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="12,0">
                        <TextBlock Text="RECENT CHATS" Style="{StaticResource MutedText}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="CompactBudgetLabel" Text="CONTEXT / 150k" Style="{StaticResource MutedText}" FontSize="10.5"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl x:Name="RecentChatList" Grid.Row="1" Margin="6,0" automation:AutomationProperties.Name="Six most recent Codex chats">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CompactChatRow}" Tag="{Binding Id}" Click="RecentChatButton_Click"
                                        ToolTip="{Binding Title}" automation:AutomationProperties.Name="{Binding AutomationName}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{Binding ZoneBrush}" Margin="2,0,9,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" FontWeight="Medium"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Context}" FontSize="12" FontWeight="SemiBold"
                                                   Margin="12,0,3,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource SurfaceStrongBrush}" BorderThickness="0,1,0,0">
                        <TextBlock x:Name="QuotaSummaryLabel" Text="QUOTA   5h —   ·   Weekly —" Style="{StaticResource MutedText}"
                                   Margin="12,0" VerticalAlignment="Center" FontSize="10.5"
                                   automation:AutomationProperties.Name="Account quota unavailable" />
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="ExpandedPanel" Grid.Row="1" Margin="14,2,14,12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="245" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="SearchBox" Grid.Row="0" TextChanged="SearchBox_TextChanged"
                                 ToolTip="Search local chat names, IDs, and project paths" automation:AutomationProperties.Name="Search local chats" />
                        <CheckBox x:Name="ArchivedCheckBox" Grid.Row="1" Content="Include archived" Margin="2,9,0,7"
                                  Checked="ArchivedCheckBox_Changed" Unchecked="ArchivedCheckBox_Changed" />
                        <ListBox x:Name="ChatList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="ChatList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 automation:AutomationProperties.Name="Codex chats">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="3,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{Binding ZoneBrush}" Margin="0,1,8,0" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" />
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource MutedText}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Context}" FontSize="11.5" FontWeight="SemiBold" Margin="8,1,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock x:Name="ModeLabel" Text="Selected chat" Style="{StaticResource MutedText}" FontSize="10.5" />
                                <TextBlock x:Name="TrackedTitle" Text="Connecting to Codex…" FontSize="14" FontWeight="SemiBold"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="39" Margin="0,2,0,0"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </StackPanel>
                            <Button x:Name="PinButton" Grid.Column="1" Style="{StaticResource IconButton}" Click="PinButton_Click"
                                    ToolTip="Follow this chat in Expanded View" automation:AutomationProperties.Name="Follow this chat">
                                <Viewbox Width="15" Height="15">
                                    <Path Data="M8,2 L16,2 L16,4 L15,5 L15,12 L18,15 L18,17 L13,17 L13,22 L11,22 L11,17 L6,17 L6,15 L9,12 L9,5 L8,4 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Viewbox>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ContextValue" Text="—" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock x:Name="BudgetValue" Text=" / 150k" Style="{StaticResource MutedText}" Margin="4,7,0,0" />
                                </StackPanel>
                                <Border x:Name="ZoneBadge" HorizontalAlignment="Right" Padding="7,3" Background="{DynamicResource CanvasBrush}"
                                        BorderBrush="{DynamicResource SurfaceStrongBrush}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                                    <TextBlock x:Name="ZoneLabel" Text="Healthy" FontSize="10.5" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ProgressBar x:Name="ContextMeter" Grid.Row="1" Style="{StaticResource Meter}" Margin="0,7,0,0"
                                         automation:AutomationProperties.Name="Context budget used" />
                            <TextBlock x:Name="OriginStatusLabel" Grid.Row="2" Text="Context origin unavailable for this adapter"
                                       Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,5,0,0" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,16,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid>
                                    <TextBlock Text="INPUT" Style="{StaticResource MutedText}" FontSize="10.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="InputValue" Text="—" HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" />
                                </Grid>
                                <Grid Height="7" Margin="0,6,0,5" ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="InputCachedColumn" Width="1*" />
                                        <ColumnDefinition x:Name="InputWriteColumn" Width="0*" />
                                        <ColumnDefinition x:Name="InputNewColumn" Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="3,0,0,3" />
                                    <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" />
                                    <Border Grid.Column="2" Background="{DynamicResource MutedBrush}" CornerRadius="0,3,3,0" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="10">
                                        <Run Text="Cached " /><Run x:Name="CachedValue" Text="—" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" FontSize="10">
                                        <Run Text="New " /><Run x:Name="NewInputValue" Text="—" FontWeight="SemiBold" />
                                    </TextBlock>
                                </Grid>
                                <TextBlock Style="{StaticResource MutedText}" FontSize="10" Margin="0,2,0,0">
                                    <Run Text="Cache write " /><Run x:Name="CacheWriteValue" Text="—" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Grid>
                                    <TextBlock Text="OUTPUT" Style="{StaticResource MutedText}" FontSize="10.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="OutputValue" Text="—" HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" />
                                </Grid>
                                <Grid Height="7" Margin="0,6,0,5" ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="OutputReasoningColumn" Width="1*" />
                                        <ColumnDefinition x:Name="OutputVisibleColumn" Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="3,0,0,3" />
                                    <Border Grid.Column="1" Background="{DynamicResource MutedBrush}" CornerRadius="0,3,3,0" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="10">
                                        <Run Text="Reasoning " /><Run x:Name="ReasoningValue" Text="—" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" FontSize="10">
                                        <Run Text="Visible " /><Run x:Name="VisibleOutputValue" Text="—" FontWeight="SemiBold" />
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="ThreadGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                                  AlternatingRowBackground="{DynamicResource CanvasBrush}" HorizontalGridLinesBrush="{DynamicResource SurfaceStrongBrush}"
                                  Foreground="{DynamicResource InkBrush}" FontSize="11.5" RowHeight="30" SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="" Binding="{Binding Marker}" Width="22" />
                                <DataGridTextColumn Header="Thread" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Context" Binding="{Binding Context}" Width="76" />
                                <DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="74" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="4" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="OpenChatButton" Content="Open chat" Style="{StaticResource QuietButton}" IsEnabled="False"
                                    ToolTip="Opening a Codex desktop chat is not available through this Experimental adapter." />
                            <Button x:Name="CompactContextButton" Grid.Column="1" Content="Compact context" Style="{StaticResource QuietButton}"
                                    Margin="7,0,0,0" IsEnabled="False" ToolTip="Compaction requires a supported Codex control connection." />
                            <Button x:Name="ClearContextButton" Grid.Column="2" Content="Clear context" Style="{StaticResource QuietButton}"
                                    Margin="7,0,0,0" IsEnabled="False" ToolTip="Same-chat Context Reset is not exposed by Codex." />
                            <Button Grid.Column="3" Content="Settings" x:Name="SettingsButton" Style="{StaticResource QuietButton}"
                                    HorizontalAlignment="Right" Click="SettingsButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="StatusBar" Grid.Row="2" Margin="16,0,16,9" Visibility="Collapsed">
                <TextBlock x:Name="SourceHealthLabel" Text="Local source status" Style="{StaticResource MutedText}" FontSize="10.5" />
                <TextBlock x:Name="RefreshLabel" Text="—" Style="{StaticResource MutedText}" FontSize="10.5" HorizontalAlignment="Right" />
            </Grid>

            <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource SurfaceStrongBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12" MinWidth="310" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Context budget" VerticalAlignment="Center" FontSize="12" />
                            <TextBox x:Name="BudgetBox" Grid.Column="1" LostFocus="BudgetBox_LostFocus" KeyDown="BudgetBox_KeyDown"
                                     ToolTip="Context budget in tokens" />
                        </Grid>
                        <CheckBox x:Name="TopmostCheckBox" Content="Always on top" Margin="0,10,0,0"
                                  Checked="TopmostCheckBox_Changed" Unchecked="TopmostCheckBox_Changed" />
                        <CheckBox x:Name="NotifyCheckBox" Content="Notifications" Margin="0,8,0,0"
                                  Checked="NotifyCheckBox_Changed" Unchecked="NotifyCheckBox_Changed" />
                        <Button x:Name="PauseButton" Content="Pause monitoring" Style="{StaticResource QuietButton}"
                                Margin="0,12,0,0" HorizontalAlignment="Left" Click="PauseButton_Click" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
