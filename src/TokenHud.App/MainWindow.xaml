<Window x:Class="TokenHud.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="Token HUD"
        Width="392" Height="390"
        MinWidth="360" MinHeight="360"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ToolTipService.InitialShowDelay="250"
        ToolTipService.BetweenShowDelay="100"
        ToolTipService.ShowDuration="12000"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        StateChanged="Window_StateChanged"
        KeyDown="Window_KeyDown">
    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Background="{DynamicResource CanvasBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleStrip" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleStrip_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="HealthDot" Grid.Column="0" Width="8" Height="8" Margin="14,0,10,0"
                         Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                         automation:AutomationProperties.Name="Waiting for a local refresh" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Token HUD" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock x:Name="MonitorStatusLabel" Margin="8,0,0,0" Style="{StaticResource MutedText}"
                               FontSize="10.5" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,6,0"
                            automation:AutomationProperties.Name="Window controls">
                    <Button x:Name="PrivacyButton" Style="{StaticResource IconButton}" Click="PrivacyButton_Click"
                            ToolTip="Hide chat names" automation:AutomationProperties.Name="Hide chat names">
                        <Viewbox Width="17" Height="17">
                            <Grid Width="24" Height="24">
                                <Path Data="M2,12 C5,7 8,5 12,5 C16,5 19,7 22,12 C19,17 16,19 12,19 C8,19 5,17 2,12 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Fill="Transparent" />
                                <Ellipse Width="6" Height="6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" />
                                <Path Data="M4,3 L20,21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" />
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="ExpandButton" Style="{StaticResource IconButton}" Click="ExpandButton_Click"
                            ToolTip="Show all chats and details" automation:AutomationProperties.Name="Show all chats and details">
                        <Viewbox Width="16" Height="16">
                            <Path Data="M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="HideButton" Style="{StaticResource IconButton}" Click="HideButton_Click" ToolTip="Hide to notification area"
                            automation:AutomationProperties.Name="Hide to notification area">
                        <Viewbox Width="16" Height="16">
                            <Path Data="M5,17 L19,17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <Border x:Name="CompactPanel" Grid.Row="1" Margin="12,2,12,12" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,0">
                        <TextBlock Text="RECENT CHATS" Style="{StaticResource MutedText}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="CompactBudgetLabel" Text="CONTEXT LOAD / 150k" Style="{StaticResource MutedText}" FontSize="10.5"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl x:Name="RecentChatList" Grid.Row="1" Margin="6,0" automation:AutomationProperties.Name="Six most recent Codex chats">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CompactChatRow}" Tag="{Binding Id}" Click="RecentChatButton_Click"
                                        ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                        automation:AutomationProperties.Name="{Binding AutomationName}">
                                    <Button.ToolTip>
                                        <ToolTip Content="{Binding PlacementTarget.DataContext.Title, RelativeSource={RelativeSource Self}}"
                                                 MaxWidth="420">
                                            <ToolTip.ContentTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ToolTip.ContentTemplate>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="77" />
                                            <ColumnDefinition Width="54" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium" Margin="0,0,9,0"
                                                   LineHeight="15" LineStackingStrategy="BlockLineHeight" MaxHeight="31"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Zone}" Foreground="{Binding ZoneBrush}" FontSize="11"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Context}" TextAlignment="Right" FontSize="12"
                                                   FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyChatsLabel" Grid.Row="1" Text="Waiting for a local refresh"
                               Style="{StaticResource MutedText}" FontSize="12.5" Margin="14,0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               automation:AutomationProperties.LiveSetting="Polite" />

                    <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                        <TextBlock x:Name="QuotaSummaryLabel" Text="Account quota   5h —   ·   Weekly —" Style="{StaticResource MutedText}"
                                   Margin="14,0" VerticalAlignment="Center" FontSize="11"
                                   automation:AutomationProperties.Name="Account quota unavailable" />
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="ExpandedPanel" Grid.Row="1" Margin="20,2,20,12" Visibility="Collapsed"
                  SizeChanged="ExpandedPanel_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                    <Button x:Name="BrowserToggleButton" Content="Browse chats" Style="{StaticResource QuietButton}"
                            Visibility="Collapsed" Click="BrowserToggleButton_Click" />
                    <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="_Settings" Style="{StaticResource QuietButton}"
                            Click="SettingsButton_Click" />
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="BrowserColumn" Width="245" />
                        <ColumnDefinition x:Name="BrowserGapColumn" Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="BrowserPanel" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Label x:Name="SearchLabel" Content="_Search chats" Target="{Binding ElementName=SearchBox}"
                                   Padding="0,0,0,5" FontWeight="SemiBold" />
                            <TextBox x:Name="SearchBox" Grid.Row="1" TextChanged="SearchBox_TextChanged"
                                     ToolTip="Search local chat names, IDs, and project paths" automation:AutomationProperties.Name="Search local chats" />
                            <CheckBox x:Name="ArchivedCheckBox" Grid.Row="2" Content="Include archived" Margin="2,9,0,7"
                                      Checked="ArchivedCheckBox_Changed" Unchecked="ArchivedCheckBox_Changed" />
                            <ListBox x:Name="ChatList" Grid.Row="3" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                     SelectionChanged="ChatList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     automation:AutomationProperties.Name="Codex chats">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="ToolTip" Value="{Binding Title}" />
                                        <Setter Property="automation:AutomationProperties.Name">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}{0}, {1}, context load {2}, {3}">
                                                    <Binding Path="Title" />
                                                    <Binding Path="Meta" />
                                                    <Binding Path="Context" />
                                                    <Binding Path="Zone" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="3,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Fill="{Binding ZoneBrush}" Margin="0,1,8,0" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" />
                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource MutedText}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="8,1,0,0">
                                                <TextBlock Text="{Binding Context}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding Zone}" Style="{StaticResource MutedText}" FontSize="10.5" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="BrowserEmptyLabel" Grid.Row="3" Text="No chats available"
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="3,4,3,0"
                                       automation:AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                    </Border>

                    <Border x:Name="DetailPanel" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      automation:AutomationProperties.Name="Selected chat details">
                            <StackPanel Margin="16">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock x:Name="ModeLabel" Text="Selected chat" Style="{StaticResource MutedText}" FontSize="10.5" />
                                        <TextBlock x:Name="TrackedTitle" Text="Connecting to Codex…" FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="39" Margin="0,2,0,0"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </StackPanel>
                                    <WrapPanel>
                                        <Button x:Name="FollowLatestButton" Content="Follow latest" Style="{StaticResource QuietButton}"
                                                Click="FollowLatestButton_Click" Margin="0,0,6,4" />
                                        <Button x:Name="PinButton" Content="Pin chat" Style="{StaticResource QuietButton}"
                                                Click="PinButton_Click" Margin="0,0,0,4" />
                                    </WrapPanel>
                                </StackPanel>

                                <TextBlock Text="Context Load" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0" />
                                <Grid Margin="0,3,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,8,0">
                                            <TextBlock x:Name="ContextValue" Text="—" FontSize="22" FontWeight="SemiBold" />
                                            <TextBlock x:Name="BudgetValue" Text=" / 150k" Style="{StaticResource MutedText}" Margin="4,7,0,0" />
                                        </StackPanel>
                                        <Border x:Name="ZoneBadge" HorizontalAlignment="Right" Padding="7,3" Background="{DynamicResource CanvasBrush}"
                                                BorderBrush="{DynamicResource SurfaceStrongBrush}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                                            <TextBlock x:Name="ZoneLabel" Text="Unavailable" FontSize="10.5" FontWeight="SemiBold" />
                                        </Border>
                                    </DockPanel>
                                    <ProgressBar x:Name="ContextMeter" Grid.Row="1" Visibility="Hidden" Style="{StaticResource Meter}" Margin="0,7,0,0"
                                                 automation:AutomationProperties.Name="Context budget used" />
                                    <TextBlock x:Name="OriginStatusLabel" Grid.Row="2" Text="Context origin unavailable for this adapter"
                                               Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </Grid>

                                <TextBlock Text="Token Flow" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,0" />
                                <TextBlock x:Name="TokenFlowStatusLabel" Text="Latest exchange unavailable"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <UniformGrid Columns="2" Margin="0,9,0,0">
                                    <StackPanel Margin="0,0,7,0">
                                        <Grid>
                                            <TextBlock Text="INPUT" Style="{StaticResource MutedText}" FontSize="10.5" FontWeight="SemiBold" />
                                            <TextBlock x:Name="InputValue" Text="—" HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid Height="7" Margin="0,6,0,5" ClipToBounds="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="InputCachedColumn" Width="0" />
                                                <ColumnDefinition x:Name="InputWriteColumn" Width="0*" />
                                                <ColumnDefinition x:Name="InputNewColumn" Width="0" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="3,0,0,3" />
                                            <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" />
                                            <Border Grid.Column="2" Background="{DynamicResource MutedBrush}" CornerRadius="0,3,3,0" />
                                        </Grid>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource MutedText}" FontSize="11.5">
                                                <Run Text="Cached " /><Run x:Name="CachedValue" Text="—" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedText}" FontSize="11.5">
                                                <Run Text="New " /><Run x:Name="NewInputValue" Text="—" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0">
                                            <Run Text="Cache write " /><Run x:Name="CacheWriteValue" Text="—" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Margin="7,0,0,0">
                                        <Grid>
                                            <TextBlock Text="OUTPUT" Style="{StaticResource MutedText}" FontSize="10.5" FontWeight="SemiBold" />
                                            <TextBlock x:Name="OutputValue" Text="—" HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid Height="7" Margin="0,6,0,5" ClipToBounds="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="OutputReasoningColumn" Width="0" />
                                                <ColumnDefinition x:Name="OutputVisibleColumn" Width="0" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="3,0,0,3" />
                                            <Border Grid.Column="1" Background="{DynamicResource MutedBrush}" CornerRadius="0,3,3,0" />
                                        </Grid>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource MutedText}" FontSize="11.5">
                                                <Run Text="Reasoning " /><Run x:Name="ReasoningValue" Text="—" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedText}" FontSize="11.5">
                                                <Run Text="Visible " /><Run x:Name="VisibleOutputValue" Text="—" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="Thread readings" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,0" />
                                <TextBlock x:Name="ThreadStatusLabel" Text="Thread readings unavailable"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <DataGrid x:Name="ThreadGrid" Margin="0,7,0,0" MaxHeight="172"
                                          automation:AutomationProperties.Name="Thread readings" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                                          AlternatingRowBackground="{DynamicResource CanvasBrush}" HorizontalGridLinesBrush="{DynamicResource DividerBrush}"
                                          Foreground="{DynamicResource InkBrush}" FontSize="11.5" RowHeight="30" SelectionMode="Single" SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="" Binding="{Binding Marker}" Width="22" />
                                        <DataGridTextColumn Header="Thread" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Context Load" Binding="{Binding Context}" Width="90" />
                                        <DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="92" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Metrics History" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,0" />
                                <TextBlock x:Name="HistoryStatusLabel" Text="No recent Context Load readings"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           automation:AutomationProperties.LiveSetting="Polite" />
                                <ItemsControl x:Name="HistoryChart" Height="37" MaxWidth="480" Margin="0,7,0,0"
                                              HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" Visibility="Collapsed"
                                              automation:AutomationProperties.Name="Recent Context Load readings">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                                                <ItemsPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="{Binding Height}" MinHeight="1" MaxHeight="36" Width="9"
                                                    Margin="1,0" CornerRadius="2,2,0,0" VerticalAlignment="Bottom"
                                                    Background="{DynamicResource PrimaryBrush}" ToolTip="{Binding Description}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                                        Margin="0,16,0,0" Padding="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Account Quota" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ExpandedQuotaLabel" Text="Five-hour unavailable · Weekly unavailable"
                                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="StatusBar" Margin="0,16,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Source health" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SourceHealthLabel" Text="Local source status"
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock x:Name="RefreshLabel" Text="—" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Expander Header="AI sources" Foreground="{DynamicResource InkBrush}" Margin="0,16,0,0" Expanded="ProviderSources_Expanded">
                                    <ItemsControl x:Name="ProviderSources" AutomationProperties.Name="Connected AI sources" Margin="4,8,2,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                                    <Button Content="Usage help" Tag="{Binding Link}" Click="OpenProviderHelp_Click" automation:AutomationProperties.Name="{Binding Title, StringFormat={}{0} usage help}"
                                                            HorizontalAlignment="Left" Margin="0,4,0,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Link}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>

                                <TextBlock Text="Chat actions" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,6" />
                                <WrapPanel>
                                    <Button x:Name="OpenChatButton" Content="Open chat" Style="{StaticResource QuietButton}"
                                            Margin="0,0,6,6" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                                            ToolTip="{Binding Text, ElementName=ChatActionStatusLabel}"
                                            automation:AutomationProperties.HelpText="{Binding Text, ElementName=ChatActionStatusLabel}" />
                                    <Button x:Name="CompactContextButton" Content="Compact context" Style="{StaticResource QuietButton}"
                                            Margin="0,0,6,6" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Compaction requires a supported Codex control connection."
                                            automation:AutomationProperties.HelpText="Compaction requires a supported Codex control connection." />
                                    <Button x:Name="ClearContextButton" Content="Clear context" Style="{StaticResource QuietButton}"
                                            Margin="0,0,0,6" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Codex does not expose same-chat context reset."
                                            automation:AutomationProperties.HelpText="Codex does not expose same-chat context reset." />
                                </WrapPanel>
                                <TextBlock x:Name="ChatActionStatusLabel" Text="Open chat requires a verified Codex desktop route."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                <TextBlock Text="Compaction requires a supported Codex control connection."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBlock Text="Codex does not expose same-chat context reset."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                   Opened="SettingsPopup_Opened" Closed="SettingsPopup_Closed">
                <Border x:Name="SettingsSurface" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource SurfaceStrongBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12" MinWidth="250" Margin="0,6,0,0" PreviewKeyDown="SettingsSurface_PreviewKeyDown"
                        KeyboardNavigation.TabNavigation="Cycle">
                    <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto">
                    <StackPanel Width="276">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="CloseSettingsButton" DockPanel.Dock="Right" Content="Close" Style="{StaticResource QuietButton}"
                                    Click="CloseSettingsButton_Click" automation:AutomationProperties.Name="Close settings" />
                            <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Context budgets" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="_Installation default" Target="{Binding ElementName=BudgetBox}" Padding="0"
                                   VerticalAlignment="Center" FontSize="12" />
                            <TextBox x:Name="BudgetBox" Grid.Column="1" LostFocus="BudgetBox_LostFocus" KeyDown="BudgetBox_KeyDown"
                                     automation:AutomationProperties.Name="Installation context budget in tokens" />
                            <Label Content="_Codex override" Target="{Binding ElementName=ProviderBudgetBox}" Padding="0"
                                   Grid.Row="1" VerticalAlignment="Center" FontSize="12" />
                            <TextBox x:Name="ProviderBudgetBox" Grid.Row="1" Grid.Column="1" Margin="0,5,0,0"
                                     LostFocus="BudgetBox_LostFocus" KeyDown="BudgetBox_KeyDown"
                                     automation:AutomationProperties.Name="Codex context budget override in tokens" />
                            <Label Content="Selected c_hat" Target="{Binding ElementName=ChatBudgetBox}" Padding="0"
                                   Grid.Row="2" VerticalAlignment="Center" FontSize="12" />
                            <TextBox x:Name="ChatBudgetBox" Grid.Row="2" Grid.Column="1" Margin="0,5,0,0"
                                     LostFocus="BudgetBox_LostFocus" KeyDown="BudgetBox_KeyDown"
                                     automation:AutomationProperties.Name="Selected chat context budget override in tokens" />
                        </Grid>
                        <TextBlock Text="Leave overrides blank to inherit." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        <TextBlock x:Name="BudgetSourceLabel" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <CheckBox x:Name="TopmostCheckBox" Content="Always on top" Margin="0,10,0,0"
                                  Checked="TopmostCheckBox_Changed" Unchecked="TopmostCheckBox_Changed" />
                        <CheckBox x:Name="NotifyCheckBox" Content="Notifications" Margin="0,8,0,0"
                                  Checked="NotifyCheckBox_Changed" Unchecked="NotifyCheckBox_Changed" />
                        <StackPanel x:Name="AlertPreferencesPanel" Margin="14,0,0,0">
                            <CheckBox x:Name="NotifyCautionCheckBox" Content="Caution" Margin="0,4,0,0"
                                      Checked="ZonePreferenceChanged" Unchecked="ZonePreferenceChanged" />
                            <CheckBox x:Name="NotifyCriticalCheckBox" Content="Critical" Margin="0,4,0,0"
                                      Checked="ZonePreferenceChanged" Unchecked="ZonePreferenceChanged" />
                            <CheckBox x:Name="NotifyOverBudgetCheckBox" Content="Over budget" Margin="0,4,0,0"
                                      Checked="ZonePreferenceChanged" Unchecked="ZonePreferenceChanged" />
                            <Button x:Name="SnoozeAlertsButton" Content="Snooze for 1 hour" Style="{StaticResource QuietButton}"
                                    Margin="0,8,0,0" HorizontalAlignment="Left" Click="SnoozeAlertsButton_Click" />
                        </StackPanel>
                        <Button x:Name="PauseButton" Content="Pause monitoring" Style="{StaticResource QuietButton}"
                                Margin="0,12,0,0" HorizontalAlignment="Left" Click="PauseButton_Click" />
                        <TextBlock Text="Metrics History" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <DockPanel LastChildFill="True">
                            <Label Content="_Retention" Target="{Binding ElementName=HistoryRetentionComboBox}"
                                   Padding="0" VerticalAlignment="Center" FontSize="12" />
                            <ComboBox x:Name="HistoryRetentionComboBox" Width="126" HorizontalAlignment="Right"
                                      SelectionChanged="HistoryRetentionComboBox_SelectionChanged" SelectedValuePath="Tag"
                                      Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}"
                                      BorderBrush="{DynamicResource PrimaryBrush}"
                                      automation:AutomationProperties.Name="Metrics History retention">
                                <ComboBoxItem Content="Off" Tag="Off" />
                                <ComboBoxItem Content="7 days" Tag="Days7" />
                                <ComboBoxItem Content="30 days" Tag="Days30" />
                                <ComboBoxItem Content="90 days" Tag="Days90" />
                                <ComboBoxItem Content="Indefinite" Tag="Indefinite" />
                            </ComboBox>
                        </DockPanel>
                        <Button x:Name="ClearHistoryButton" Content="Clear Metrics History" Style="{StaticResource QuietButton}"
                                Margin="0,7,0,0" HorizontalAlignment="Left" Click="ClearHistoryButton_Click" />
                        <TextBlock x:Name="HistorySettingsStatusLabel" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   automation:AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
